{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emora",
  "version": "0.2.0",
  "identifier": "com.emora.assistant",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Emotion-aware assistant",
    "longDescription": "Emora desktop shell: starts the local Emora backend and opens the assistant."
  }
}
