# LLM — uses OpenAI-compatible client (works with any OpenAI-compatible API)
# OpenAI:   LLM_API_KEY=sk-...          LLM_MODEL=gpt-4o-mini
# Gemini:   LLM_API_KEY=...             LLM_MODEL=gemini-2.0-flash   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq:     LLM_API_KEY=gsk_...         LLM_MODEL=llama-3.3-70b     LLM_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek: LLM_API_KEY=sk-...          LLM_MODEL=deepseek-chat      LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional: custom base URL for OpenAI-compatible endpoints (omit for default https://api.openai.com/v1)
# LLM_BASE_URL=https://api.openai.com/v1

DATABASE_URL=sqlite:///./data/emotion_assistant.db
SECRET_KEY=change-me-to-a-random-string

# Preload STT + emotion models at startup. 1 = ready immediately but ~2-3 GB of
# RAM held; 0 = load on first use (first voice turn takes 1-2 minutes).
# 0 is the safe default for a machine with 16 GB or less.
EMORA_WARMUP=0

# Anti-spoofing on face login (rejects a photo held up to the camera).
# 0 disables it if the extra model can't download or a dark webcam trips it.
EMORA_FACE_LIVENESS=1
